# Copia este archivo a scripts/agente-qa/.env.qa.local y completa los valores.
# ESTE ARCHIVO ES SOLO PARA EL PROYECTO SUPABASE DE PRUEBA (agenda-shimaya-qa-agentes),
# nunca el real -- el agente va a crear/editar/borrar datos sin filtro.

# Panel de Supabase del proyecto DE PRUEBA -> Project Settings -> API
QA_SUPABASE_URL=
QA_SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga y aleatoria, solo para firmar sesiones en este entorno
# de prueba -- no tiene que coincidir con el SESSION_SECRET real.
# Genera una con: openssl rand -base64 32
QA_SESSION_SECRET=

# Puerto local donde el script levanta `next dev` apuntando a la base de
# prueba (por defecto 3100, para no pisar un `npm run dev` normal en 3000).
QA_APP_PORT=3100

# Clave (credencial de login) de cada uno de los 4 usuarios de prueba que crea
# seed.ts -- el agente las usa para iniciar sesión. Pueden ser cualquier texto;
# seed.ts las guarda hasheadas igual que el login real.
QA_CLAVE_SUPERVISOR=qa-supervisor-001
QA_CLAVE_CAPACITADOR=qa-capacitador-001
QA_CLAVE_COORDINADOR=qa-coordinador-001
QA_CLAVE_GERENTE=qa-gerente-001

# Opcional -- si no está, se usa la sesión activa de `ant auth login`.
ANTHROPIC_API_KEY=
