# Copia este archivo a .env.local para desarrollo local, y configura
# estas mismas 3 variables en Vercel (Project Settings -> Environment Variables)
# para producción.

# Panel de Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://vcxedfrldesstgbvkhcf.supabase.co

# Panel de Supabase -> Project Settings -> API -> service_role key (secreta,
# NUNCA la compartas ni la subas a GitHub — por eso .env.local está en .gitignore)
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga y aleatoria — se usa para firmar las sesiones (JWT).
# Genera una con: openssl rand -base64 32
SESSION_SECRET=
